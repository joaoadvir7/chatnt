// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conexão oficial com o WhatsApp Business API (WABA) via Meta Cloud API
model WhatsAppConnection {
  id            String @id @default(cuid())
  name          String // nome dado pelo usuário para identificar a conexão
  phoneNumber   String @unique // número em formato E.164, ex: +5511999999999
  wabaId        String // WhatsApp Business Account ID
  phoneNumberId String @unique // Meta phone_number_id, usado nas chamadas de envio
  accessToken   String // System User access token (permanente) — nunca retornar ao client

  verifiedName     String? // nome verificado retornado pela Meta
  businessVerified Boolean @default(false)
  qualityRating    String? // HIGH, MEDIUM, LOW, UNKNOWN — reportado pela Meta
  messagingLimit   String? // tier de mensagens/24h reportado pela Meta, ex: "1K", "100K"
  isActive         Boolean @default(true)

  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversations Conversation[]

  @@map("whatsapp_connections")
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

model Conversation {
  id           String             @id @default(cuid())
  contactId    String
  contact      Contact            @relation(fields: [contactId], references: [id])
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id])
  status       ConversationStatus @default(OPEN)

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]

  @@unique([contactId, connectionId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  content        String
  status         String? // sent, delivered, read, failed (outbound) — null para inbound
  waMessageId    String?          @unique // id da mensagem retornado pela Meta (idempotência do webhook)
  createdAt      DateTime         @default(now())

  @@map("messages")
}

// Área/perfil de acesso do atendente (ex: Coordenador Base, Admin Master)
model Area {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  attendants Attendant[]

  @@map("areas")
}

model Attendant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  isOnline  Boolean  @default(false)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendants")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  source    String? // origem da captação: TV, revista, formulário, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags              ContactTag[]
  customFieldValues ContactCustomFieldValue[]
  conversations     Conversation[]

  @@map("contacts")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366F1")
  createdAt DateTime @default(now())

  contacts ContactTag[]

  @@map("tags")
}

// Tabela de junção explícita para permitir auditoria de quando a tag foi aplicada
model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomField {
  id        String          @id @default(cuid())
  name      String
  key       String          @unique // slug usado para referenciar o campo (ex: "distrito")
  type      CustomFieldType @default(TEXT)
  options   Json? // opções disponíveis quando type = SELECT
  createdAt DateTime        @default(now())

  values ContactCustomFieldValue[]

  @@map("custom_fields")
}

model ContactCustomFieldValue {
  id            String   @id @default(cuid())
  contactId     String
  customFieldId String
  value         String
  updatedAt     DateTime @updatedAt

  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, customFieldId])
  @@map("contact_custom_field_values")
}
